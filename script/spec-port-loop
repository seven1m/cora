#!/usr/bin/env bash

set -euo pipefail

usage() {
  cat <<'EOF'
Usage: script/spec-port-loop [options]

Drive a repeatable Codex workflow for ruby/spec porting in this repo.
Suspicious porter/cleanup outcomes trigger a lightweight Codex judge pass.

Options:
  --target PATH                 Port a specific spec path from spec/TODO.md instead of auto-picking.
  --max-ports N                 Stop after N porter attempts, including failed ones. Default: unlimited.
  --cleanup-every-commits N     Run cleanup after N real Git commits since the last cleanup anchor. Default: 10.
  --resume-last                 Use `codex exec resume --last` after the first successful run.
  --dry-run                     Print the next actions without invoking Codex.
  --codex-bin PATH              Codex executable. Default: codex.
  --codex-arg ARG               Extra argument passed through to every Codex invocation. Repeatable.
  -h, --help                    Show this help.

Examples:
  script/spec-port-loop --max-ports 3 --codex-arg --full-auto
  script/spec-port-loop --resume-last --cleanup-every-commits 12
  script/spec-port-loop --target core/array/assoc_spec.rb --dry-run
EOF
}

die() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

quote_args() {
  local out="" arg
  for arg in "$@"; do
    out+=" $(printf '%q' "$arg")"
  done
  printf '%s\n' "${out# }"
}

current_head() {
  git -C "$repo_root" rev-parse HEAD
}

count_commits_since() {
  local anchor=$1
  git -C "$repo_root" rev-list --count "${anchor}..HEAD"
}

dashboard_enabled=0
dashboard_goal_specs=25000
dashboard_total_specs=0
dashboard_total_specs_known=0
dashboard_current_label="idle"
dashboard_current_status="booting"
dashboard_current_spec=""
dashboard_current_log_file=""
dashboard_current_log_line=0
dashboard_spinner_index=0
dashboard_last_commit_refresh=0
dashboard_commits_since_cleanup=0
dashboard_recent_commits_text="Loading git log --stat..."
dashboard_recent_commits_lines=()
dashboard_activity_lines=()
dashboard_last_render_lines=0
dashboard_probe_active=0
dashboard_probe_fd=""
dashboard_probe_pid=""
dashboard_probe_fallback_total=0
dashboard_probe_started_at=0
dashboard_usage_text="Usage: loading..."
dashboard_last_usage_refresh=0
codex_sessions_dir="${HOME}/.codex/sessions"

dashboard_repeat() {
  local count=$1
  local char=${2:-" "}
  local out=""

  if ((count <= 0)); then
    return 0
  fi

  printf -v out '%*s' "$count" ''
  printf '%s' "${out// /$char}"
}

dashboard_plain() {
  local text=$1
  local width=$2

  if ((width <= 0)); then
    return 0
  fi

  if ((${#text} > width)); then
    if ((width == 1)); then
      printf '%s' "${text:0:1}"
    else
      printf '%s' "${text:0:width-1}~"
    fi
    return
  fi

  printf '%-*s' "$width" "$text"
}

dashboard_record_activity() {
  local line=${1//$'\r'/}
  dashboard_activity_lines+=("$line")
  if ((${#dashboard_activity_lines[@]} > 400)); then
    dashboard_activity_lines=("${dashboard_activity_lines[@]: -400}")
  fi
}

dashboard_note() {
  local message=$1
  if [[ "$dashboard_enabled" -eq 1 ]]; then
    dashboard_record_activity "$message"
  else
    printf '%s\n' "$message" >&2
  fi
}

dashboard_update_total_specs_from_line() {
  local line=$1

  if [[ "$line" =~ ^[[:space:]]*[0-9]+/([0-9]+)[[:space:]]+specs[[:space:]] ]]; then
    dashboard_total_specs=${BASH_REMATCH[1]}
    dashboard_probe_fallback_total=${BASH_REMATCH[1]}
    dashboard_total_specs_known=1
    return
  fi

  if [[ "$line" =~ ^Executed[[:space:]]+([0-9]+)[[:space:]]+specs\. ]]; then
    dashboard_total_specs=${BASH_REMATCH[1]}
    dashboard_total_specs_known=1
    dashboard_probe_active=0
  fi
}

dashboard_set_log_source() {
  dashboard_current_log_file=$1
  dashboard_current_log_line=0
}

dashboard_poll_log_source() {
  local total_lines new_lines line

  if [[ -z "$dashboard_current_log_file" || ! -f "$dashboard_current_log_file" ]]; then
    return 0
  fi

  total_lines=$(wc -l <"$dashboard_current_log_file")
  if ((total_lines <= dashboard_current_log_line)); then
    return 0
  fi

  new_lines=$(sed -n "$((dashboard_current_log_line + 1)),$total_lines"p "$dashboard_current_log_file")
  while IFS= read -r line; do
    dashboard_record_activity "$line"
    dashboard_update_total_specs_from_line "$line"
  done <<<"$new_lines"
  dashboard_current_log_line=$total_lines
}

dashboard_refresh_recent_commits() {
  local now line sha subject stat
  local commit_subject_width=44
  now=$(date +%s)
  if ((now - dashboard_last_commit_refresh < 3)); then
    return
  fi

  dashboard_recent_commits_lines=()
  while IFS=$'\t' read -r sha subject stat; do
    printf -v line '%-7s  %-*.*s  %s' \
      "$sha" "$commit_subject_width" "$commit_subject_width" "$subject" "$stat"
    dashboard_recent_commits_lines+=("$line")
  done < <(
    git -C "$repo_root" log -n 10 --shortstat --pretty=format:'%h%x09%s' 2>/dev/null | \
      awk '
        BEGIN { FS = "\t"; sha = ""; subject = ""; stat = "" }
        /^[0-9a-f]{7}\t/ {
          if (sha != "") {
            printf "%s\t%s\t%s\n", sha, subject, stat
          }
          sha = $1
          subject = $2
          stat = ""
          next
        }
        /file changed|files changed/ {
          gsub(/^[[:space:]]+/, "", $0)
          stat = $0
        }
        END {
          if (sha != "") {
            printf "%s\t%s\t%s\n", sha, subject, stat
          }
        }
      '
  )
  if (( ${#dashboard_recent_commits_lines[@]} == 0 )); then
    dashboard_recent_commits_lines=("git log unavailable")
  fi
  dashboard_commits_since_cleanup=$(count_commits_since "$cleanup_anchor_commit")
  dashboard_last_commit_refresh=$now
}

dashboard_refresh_usage() {
  local now
  local usage_raw primary_used secondary_used primary_window secondary_window
  now=$(date +%s)
  if ((now - dashboard_last_usage_refresh < 5)); then
    return 0
  fi

  usage_raw=$(
    python3 - <<'PY' 2>/dev/null
import glob, json, os

sessions_dir = os.path.join(os.environ.get('HOME', ''), '.codex', 'sessions')
files = sorted(glob.glob(os.path.join(sessions_dir, '**', '*.jsonl'), recursive=True), key=os.path.getmtime, reverse=True)
for path in files:
    latest = None
    try:
        with open(path, 'r', encoding='utf-8') as f:
            for line in f:
                try:
                    obj = json.loads(line)
                except Exception:
                    continue
                if obj.get('type') != 'event_msg':
                    continue
                payload = obj.get('payload') or {}
                if payload.get('type') == 'token_count' and payload.get('rate_limits'):
                    latest = payload.get('rate_limits') or {}
        if latest:
            primary = latest.get('primary') or {}
            secondary = latest.get('secondary') or {}
            print(f"{primary.get('used_percent','')}|{primary.get('window_minutes','')}|{secondary.get('used_percent','')}|{secondary.get('window_minutes','')}")
            break
    except Exception:
        continue
PY
  )

  if [[ -n "$usage_raw" ]]; then
    IFS='|' read -r primary_used primary_window secondary_used secondary_window <<< "$usage_raw"
    if [[ -n "$primary_used" && -n "$secondary_used" ]]; then
      dashboard_usage_text=$(printf 'Usage: %d%% left / %sh, %d%% left / week' \
        "$((100 - ${primary_used%.*}))" \
        "$(( ${primary_window:-300} / 60 ))" \
        "$((100 - ${secondary_used%.*}))")
    else
      dashboard_usage_text="Usage: unavailable"
    fi
  else
    dashboard_usage_text="Usage: unavailable"
  fi

  dashboard_last_usage_refresh=$now
}

dashboard_start_spec_probe() {
  local cmd=(zig build test)

  if command -v stdbuf >/dev/null 2>&1; then
    cmd=(stdbuf -oL -eL zig build test)
  fi

  coproc SPEC_COUNT_PROBE { "${cmd[@]}" 2>&1; }
  dashboard_probe_fd=${SPEC_COUNT_PROBE[0]}
  dashboard_probe_pid=$SPEC_COUNT_PROBE_PID
  dashboard_probe_active=1
  dashboard_probe_fallback_total=0
  dashboard_probe_started_at=$(date +%s)
  dashboard_note "Started background spec-count probe with zig build test"
}

dashboard_poll_spec_probe() {
  local line

  [[ "$dashboard_probe_active" -eq 1 ]] || return 0

  while IFS= read -r -t 0.001 -u "$dashboard_probe_fd" line; do
    dashboard_update_total_specs_from_line "$line"
    dashboard_record_activity "[bootstrap] $line"
  done

  if ! kill -0 "$dashboard_probe_pid" 2>/dev/null; then
    wait "$dashboard_probe_pid" 2>/dev/null || true
    dashboard_probe_active=0
    if [[ "$dashboard_total_specs_known" -eq 1 ]]; then
      dashboard_note "Captured current total specs: $dashboard_total_specs"
    elif [[ "$dashboard_probe_fallback_total" -gt 0 ]]; then
      dashboard_total_specs=$dashboard_probe_fallback_total
      dashboard_total_specs_known=1
      dashboard_note "Spec-count probe finished without final summary; using fallback count $dashboard_probe_fallback_total"
    else
      dashboard_note "Could not detect total specs from zig build test output"
    fi
  fi
}

dashboard_progress_bar() {
  local width=$1
  local current=$2
  local goal=$3
  local filled=0
  local empty
  local green_limit yellow_limit i
  local color_green=$'\033[30;42m'
  local color_yellow=$'\033[30;43m'
  local color_red=$'\033[30;41m'
  local color_empty=$'\033[30;100m'
  local color_reset=$'\033[0m'

  ((width > 0)) || return
  if ((goal > 0 && current > 0)); then
    filled=$((current * width / goal))
  fi
  ((filled > width)) && filled=$width
  empty=$((width - filled))
  green_limit=$((width * 50 / 100))
  yellow_limit=$((width * 80 / 100))

  printf '['
  for ((i = 0; i < width; i++)); do
    if ((i < filled)); then
      if ((i < green_limit)); then
        printf '%s %s' "$color_green" "$color_reset"
      elif ((i < yellow_limit)); then
        printf '%s %s' "$color_yellow" "$color_reset"
      else
        printf '%s %s' "$color_red" "$color_reset"
      fi
    else
      printf '%s %s' "$color_empty" "$color_reset"
    fi
  done
  printf ']'
}

dashboard_wave_line() {
  local width=$1
  local offset=$2
  local pattern=('▁' '▂' '▃' '▄' '▅' '▆' '▅' '▄' '▃' '▂')
  local colors=($'\033[38;5;39m' $'\033[38;5;45m' $'\033[38;5;51m' $'\033[38;5;87m')
  local color_reset=$'\033[0m'
  local i idx

  for ((i = 0; i < width; i++)); do
    idx=$(((i + offset) % ${#pattern[@]}))
    printf '%s%s%s' "${colors[i % ${#colors[@]}]}" "${pattern[idx]}" "$color_reset"
  done
}

dashboard_cleanup() {
  if [[ "$dashboard_enabled" -eq 1 ]]; then
    printf '\033[0m\033[?25h\033[?1049l'
    dashboard_enabled=0
  fi
}

dashboard_init() {
  if [[ ! -t 2 || "${TERM:-}" == "dumb" ]]; then
    return
  fi

  dashboard_enabled=1
  trap dashboard_cleanup EXIT
  printf '\033[?1049h\033[?25l'
  dashboard_refresh_recent_commits
}

dashboard_render() {
  local cols lines art_width left_width top_rows commit_rows activity_rows
  local color_reset=$'\033[0m'
  local top_left_lines art_lines progress_pct remaining_specs bar_width
  local probe_suffix=""
  local i row start_index
  local art_ruby=$'\033[38;5;196m'
  local art_cora=$'\033[38;5;45m'
  local reset=$color_reset

  if [[ "$dashboard_enabled" -ne 1 ]]; then
    return 0
  fi

  dashboard_poll_spec_probe
  dashboard_poll_log_source
  dashboard_refresh_recent_commits
  dashboard_refresh_usage

  cols=$(tput cols 2>/dev/null || printf '120')
  lines=$(tput lines 2>/dev/null || printf '40')
  art_width=28
  if ((cols < 90)); then
    art_width=22
  fi
  left_width=$((cols - art_width - 14))
  if ((left_width < 40)); then
    left_width=40
    art_width=$((cols - left_width - 3))
    ((art_width < 0)) && art_width=0
  fi

  if ((dashboard_total_specs_known == 1)); then
    progress_pct=$((dashboard_total_specs * 100 / dashboard_goal_specs))
    remaining_specs=$((dashboard_goal_specs - dashboard_total_specs))
    ((remaining_specs < 0)) && remaining_specs=0
  else
    progress_pct=0
    remaining_specs=$dashboard_goal_specs
  fi

  if [[ "$dashboard_probe_active" -eq 1 ]]; then
    probe_suffix="   [counting specs...]"
  fi

  bar_width=$((left_width - 24))
  ((bar_width < 10)) && bar_width=10

  top_left_lines=(
    " Cora Spec Port Loop   stage: ${dashboard_current_label}"
    " Specs: ${dashboard_total_specs:-0}/${dashboard_goal_specs}   remaining: ${remaining_specs}"
    " Progress"
    " Status: ${dashboard_current_status}${probe_suffix}"
    " Current spec: ${dashboard_current_spec:-auto-selecting next spec}"
    " ${dashboard_usage_text}"
    " Ports: ${successful_ports}   Cleanups: ${cleanup_runs}   Runs: ${successful_runs}"
    " Commits since cleanup: ${dashboard_commits_since_cleanup}"
  )

  art_lines=(
    "${art_cora}  ██████  ██████  ██████   █████ ${reset}"
    "${art_cora} ██      ██    ██ ██   ██ ██   ██${reset}"
    "${art_cora} ██      ██    ██ ██████  ███████${reset}"
    "${art_cora} ██      ██    ██ ██  ██  ██   ██${reset}"
    "${art_cora}  ██████  ██████  ██   ██ ██   ██${reset}"
    ""
    "${art_ruby}   ⢀⠞⠉⠉⠉⢩⡏⠉⠉⠉⢹⡍⠉⢹⣦${reset}"
    "${art_ruby} ⡔⠁⠀⠀  ⢠⡇⠀⠀⠀  ⠀⢸⣆⠀ ⠀⣷${reset}"
    "${art_ruby} ⠻⣏⠉⠉⠉⠻⡏⠉⠀⠉⠁⠁⠁ ⠀⠉⣹⣿⣿⣿⣿⡿${reset}"
    "${art_ruby}  ⠘⢷⣆⠀ ⠀⢹⡄⠀⠀ ⠀⠀⢰⣿⣿⣿⣿⠟${reset}"
    "${art_ruby}    ⠈⠳⣤⠀⠀⠘⣧⠠ ⠀⠄⣾⣿⡿⠋${reset}"
    "${art_ruby}       ⠑⢥⠀⢹⡆⠀⣼⣿⠟${reset}"
    "${art_ruby}         ⠑⢾⢿⠟${reset}"
  )

  top_rows=${#art_lines[@]}
  if ((${#top_left_lines[@]} > top_rows)); then
    top_rows=${#top_left_lines[@]}
  fi
  commit_rows=$(((lines - top_rows - 7) / 2))
  ((commit_rows < 8)) && commit_rows=8
  activity_rows=$((lines - top_rows - commit_rows - 7))
  ((activity_rows < 8)) && activity_rows=8

  local rendered_lines=0

  printf '\033[H'
  dashboard_wave_line "$cols" "$dashboard_spinner_index"
  printf '\n'
  rendered_lines=$((rendered_lines + 1))
  for ((row = 0; row < top_rows; row++)); do
    if ((row == 2)); then
      local progress_prefix=" Progress "
      local progress_suffix=" ${progress_pct}%"
      local progress_visible_width=$(( ${#progress_prefix} + bar_width + 2 + ${#progress_suffix} ))
      printf '%s' "$progress_prefix"
      dashboard_progress_bar "$bar_width" "$dashboard_total_specs" "$dashboard_goal_specs"
      printf '%s' "$progress_suffix"
      if (( left_width > progress_visible_width )); then
        dashboard_repeat "$((left_width - progress_visible_width))" ' '
      fi
    else
      dashboard_plain "${top_left_lines[row]:-}" "$left_width"
    fi
    printf '   '
    printf '%s' "${art_lines[row]:-}"
    printf '\n'
    rendered_lines=$((rendered_lines + 1))
  done

  printf '%s\n' "$(dashboard_repeat "$cols" '=')"
  rendered_lines=$((rendered_lines + 1))
  printf '\033[38;5;220mRecent Commits\033[0m\n'
  rendered_lines=$((rendered_lines + 1))
  for ((row = 0; row < commit_rows; row++)); do
    dashboard_plain "${dashboard_recent_commits_lines[row]:-}" "$cols"
    printf '\n'
    rendered_lines=$((rendered_lines + 1))
  done

  printf '%s\n' "$(dashboard_repeat "$cols" '=')"
  rendered_lines=$((rendered_lines + 1))
  printf '\033[38;5;220mActivity Log\033[0m\n'
  rendered_lines=$((rendered_lines + 1))
  start_index=0
  if ((${#dashboard_activity_lines[@]} > activity_rows)); then
    start_index=$((${#dashboard_activity_lines[@]} - activity_rows))
  fi
  for ((i = 0; i < activity_rows; i++)); do
    row=$((start_index + i))
    dashboard_plain "${dashboard_activity_lines[row]:-}" "$cols"
    printf '\n'
    rendered_lines=$((rendered_lines + 1))
  done

  if (( dashboard_last_render_lines > rendered_lines )); then
    printf '\033[J'
  else
    printf '\033[J'
  fi
  dashboard_last_render_lines=$rendered_lines
}

capture_total_specs() {
  dashboard_current_label="bootstrap"
  dashboard_current_status="starting background spec-count probe"
  dashboard_start_spec_probe
  dashboard_render
}

run_and_log() {
  local label=$1
  local log_file=$2
  local stdin_file=$3
  local status_text=$4
  shift 4

  {
    printf '==> %s\n' "$label"
    printf 'cmd: %s\n' "$(quote_args "$@")"
  } >"$log_file"

  if [[ "$stdin_file" != "-" ]]; then
    "$@" <"$stdin_file" >>"$log_file" 2>&1 &
  else
    "$@" >>"$log_file" 2>&1 &
  fi

  local cmd_pid=$!
  local spinner='-\|/'
  local i=0

  dashboard_current_label=$label
  dashboard_current_status=$status_text
  dashboard_set_log_source "$log_file"
  dashboard_render

  while kill -0 "$cmd_pid" 2>/dev/null; do
    if [[ "$dashboard_enabled" -eq 1 ]]; then
      dashboard_spinner_index=$((dashboard_spinner_index + 1))
      dashboard_current_label=$label
      dashboard_current_status=$status_text
      dashboard_render
    else
      printf '\r[%s] %s %c' "$label" "$status_text" "${spinner:i++%${#spinner}:1}"
    fi
    sleep 0.15
  done

  wait "$cmd_pid"
  local status=$?
  dashboard_poll_log_source
  if [[ "$dashboard_enabled" -eq 1 ]]; then
    dashboard_note "[$label] $status_text $([[ "$status" -eq 0 ]] && printf 'done' || printf 'failed')"
    dashboard_current_status="$status_text ($([[ "$status" -eq 0 ]] && printf 'done' || printf 'failed'))"
    dashboard_render
  else
    printf '\r[%s] %s %s\n' "$label" "$status_text" "$([[ "$status" -eq 0 ]] && printf 'done' || printf 'failed')"
  fi
  printf 'exit: %s\n' "$status" >>"$log_file"
  return "$status"
}

log_has_limit_error() {
  local log_file=$1
  [[ -f "$log_file" ]] || return 1
  rg -qi 'rate limit|usage limit|quota|5.?hour|weekly limit|try again later|too many requests|429' "$log_file"
}

next_missing_spec() {
  local todo_file=$1
  awk '
    /^\- \[ \] / {
      path = $0
      sub(/^\- \[ \] /, "", path)
      print path
      exit
    }
  ' "$todo_file"
}

hash_file() {
  local file=$1
  sha256sum "$file" | awk '{print $1}'
}

capture_status() {
  git -C "$repo_root" status --short
}

capture_recent_commits() {
  local before_head=$1
  git -C "$repo_root" log --format='%H %s' "${before_head}..HEAD"
}

capture_name_status() {
  local before_head=$1
  git -C "$repo_root" diff --name-status "${before_head}..HEAD"
}

capture_todo_diff() {
  local before_head=$1
  git -C "$repo_root" diff --no-ext-diff "${before_head}..HEAD" -- spec/TODO.md
  git -C "$repo_root" diff --no-ext-diff -- spec/TODO.md
}

ensure_clean_worktree() {
  local status
  status=$(capture_status)
  if [[ -n "$status" ]]; then
    die "worktree must be clean before running spec-port-loop"
  fi
}

rollback_to_stage_start() {
  local rollback_head=$1
  dashboard_note "Rolling back repo to $rollback_head"
  git -C "$repo_root" reset --hard "$rollback_head" >/dev/null
  git -C "$repo_root" clean -fd >/dev/null
}

run_verification_command() {
  local label=$1
  local status_text=$2
  shift 2
  local timestamp log_file

  timestamp="$(date +%Y%m%d-%H%M%S)-$$-$RANDOM"
  log_file="$runs_dir/$timestamp-$label.log"

  if [[ "$dry_run" -eq 1 ]]; then
    dashboard_note "[dry-run] $label"
    dashboard_note "[dry-run] cmd: $(quote_args "$@")"
    return 0
  fi

  run_and_log "$label" "$log_file" "-" "$status_text" "$@"
}

run_porter_verification_with_retry() {
  local rollback_head=$1
  local porter_prompt=$2
  local use_resume=$3
  local attempt=${4:-0}

  if run_verification_command "post-porter-zig-build-test" "running zig build test" zig build test; then
    return 0
  fi

  if [[ "$dry_run" -eq 1 ]]; then
    return 0
  fi

  if [[ "$attempt" -ge 1 ]]; then
    dashboard_note "Post-porter verification failed after one retry; rolling back porter attempt."
    rollback_to_stage_start "$rollback_head"
    STAGE_RESULT="rolled_back_failure"
    return 0
  fi

  dashboard_note "Post-porter verification failed; retrying porter once from current state."
  STAGE_RESULT="success"
  run_stage_with_judge "porter" "$porter_prompt" "$use_resume" 1 1 "$rollback_head" || return 1
  if [[ "$STAGE_RESULT" == "rolled_back_failure" ]]; then
    return 0
  fi

  run_porter_verification_with_retry "$rollback_head" "$porter_prompt" "$use_resume" $((attempt + 1))
}

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
todo_file="$repo_root/spec/TODO.md"
[[ -f "$todo_file" ]] || die "missing $todo_file"

codex_bin="codex"
target_spec=""
max_ports=0
cleanup_every_commits=10
resume_last=0
dry_run=0
codex_args=()
has_explicit_color=0

while [[ $# -gt 0 ]]; do
  case "$1" in
  --target)
    [[ $# -ge 2 ]] || die "--target requires a value"
    target_spec=$2
    shift 2
    ;;
  --max-ports)
    [[ $# -ge 2 ]] || die "--max-ports requires a value"
    max_ports=$2
    shift 2
    ;;
  --cleanup-every-commits)
    [[ $# -ge 2 ]] || die "--cleanup-every-commits requires a value"
    cleanup_every_commits=$2
    shift 2
    ;;
  --resume-last)
    resume_last=1
    shift
    ;;
  --dry-run)
    dry_run=1
    shift
    ;;
  --codex-bin)
    [[ $# -ge 2 ]] || die "--codex-bin requires a value"
    codex_bin=$2
    shift 2
    ;;
  --codex-arg)
    [[ $# -ge 2 ]] || die "--codex-arg requires a value"
    codex_args+=("$2")
    if [[ "$2" == "--color" || "$2" == --color=* ]]; then
      has_explicit_color=1
    fi
    shift 2
    ;;
  -h | --help)
    usage
    exit 0
    ;;
  *)
    die "unknown option: $1"
    ;;
  esac
done

[[ "$max_ports" =~ ^[0-9]+$ ]] || die "--max-ports must be an integer"
[[ "$cleanup_every_commits" =~ ^[0-9]+$ ]] || die "--cleanup-every-commits must be an integer"

if [[ "$has_explicit_color" -eq 0 ]]; then
  codex_args=(--color never "${codex_args[@]}")
fi

state_dir="$repo_root/.codex-loop/spec-port-loop"
runs_dir="$state_dir/runs"
mkdir -p "$runs_dir"
state_file="$state_dir/state.env"

if [[ "$dry_run" -eq 0 ]]; then
  ensure_clean_worktree
fi

successful_ports=0
cleanup_runs=0
successful_runs=0
cleanup_anchor_commit=$(current_head)

if [[ -f "$state_file" ]]; then
  # shellcheck disable=SC1090
  source "$state_file"
fi

dashboard_init
capture_total_specs

save_state() {
  cat >"$state_file" <<EOF
successful_ports=$successful_ports
cleanup_runs=$cleanup_runs
successful_runs=$successful_runs
cleanup_anchor_commit=$cleanup_anchor_commit
EOF
}

persist_state() {
  if [[ "$dry_run" -eq 0 ]]; then
    save_state
  fi
}

join_by() {
  local sep=$1
  shift
  local first=1 item
  for item in "$@"; do
    if [[ "$first" -eq 1 ]]; then
      printf '%s' "$item"
      first=0
    else
      printf '%s%s' "$sep" "$item"
    fi
  done
}

build_porter_prompt() {
  if [[ -n "${1:-}" ]]; then
    local spec_path=$1
    cat <<EOF
Use \$ruby-spec-porter.

Port exactly \`$spec_path\` from \`../ruby_spec\` into this repo. Follow \`AGENTS.md\` and the skill instructions closely.

Requirements:
- Choose this exact spec; do not switch to a different spec.
- Complete the work end-to-end when feasible: copy upstream spec/shared/fixtures, make the spec pass, run relevant tests, and update \`spec/TODO.md\`.
- Keep copied spec files byte-for-byte aligned with upstream whenever possible.
- Make commits non-interactively. Keep work directly required for this target spec in the same commit series as the spec itself. Only split out separate supporting commits when they are adjacent or incidental changes not directly part of making this target spec pass.
- Stop and explain clearly only if blocked by a fundamental runtime issue that should not be papered over.

Before finishing, report:
- the spec path
- whether it is now [x] or [-] in \`spec/TODO.md\`
- the tests/spec commands you ran
- the commit(s) you created
EOF
    return
  fi

  cat <<EOF
Use \$ruby-spec-porter.

Choose the next best single spec to port from \`spec/TODO.md\`, following the skill's normal candidate-selection heuristics. Follow \`AGENTS.md\` and the skill instructions closely.

Requirements:
- Pick exactly one unchecked TODO entry yourself; do not ask the outer loop to choose for you.
- Favor the next-easiest, highest-signal spec that fits the skill guidance and current repo state.
- Complete that one spec end-to-end when feasible: copy upstream spec/shared/fixtures, make the spec pass, run relevant tests, and update \`spec/TODO.md\`.
- Run \`zig build test\` before finishing; the outer loop will verify this separately too.
- Keep copied spec files byte-for-byte aligned with upstream whenever possible.
- Make commits non-interactively. Keep work directly required for the chosen spec in the same commit series as the spec itself. Only split out separate supporting commits when they are adjacent or incidental changes not directly part of making that target spec pass.
- Stop and explain clearly only if blocked by a fundamental runtime issue that should not be papered over.

Before finishing, report:
- the spec path you chose and why it was the next-best pick
- whether it is now [x] or [-] in \`spec/TODO.md\`
- the tests/spec commands you ran
- the commit(s) you created
EOF
}

build_cleanup_prompt() {
  cat <<EOF
Use \$refactor-cleanup.

Do one behavior-preserving cleanup pass in this repo after recent ruby/spec porting work. Focus on consolidating duplication or ad hoc helpers introduced by recent spec-porting changes, keep the diff scoped, run focused verification, and commit the cleanup separately.

Requirements:
- Do not mix in new feature work unless it is the minimum needed to keep behavior unchanged.
- Prefer canonical helpers already documented in \`AGENTS.md\`.
- Make one non-interactive cleanup commit.

Before finishing, report:
- the area you cleaned up
- the tests you ran
- the cleanup commit you created
EOF
}

build_selector_prompt() {
  cat <<EOF
Use \$ruby-spec-porter.

Choose exactly one unchecked entry from \`spec/TODO.md\` as the next best spec to port now, following the skill's normal candidate-selection heuristics and the current repo state.

Return exactly this format and nothing else:
SPEC: path/to/spec.rb
REASON: one sentence

If there is no suitable unchecked entry left, return:
SPEC: NONE
REASON: one sentence
EOF
}

build_codex_command() {
  local prompt=$1
  local prompt_file=$2
  local message_file=$3
  local use_resume=$4

  local cmd=("$codex_bin")
  if [[ "$use_resume" -eq 1 ]]; then
    cmd+=(exec resume --last)
  else
    cmd+=(exec)
  fi
  cmd+=(--cd "$repo_root")
  if [[ ${#codex_args[@]} -gt 0 ]]; then
    cmd+=("${codex_args[@]}")
  fi
  cmd+=(-o "$message_file")
  cmd+=(-)
  printf '%s\0' "${cmd[@]}" >"$prompt_file.cmd"
  printf '%s' "$prompt" >"$prompt_file"
}

invoke_codex() {
  local label=$1
  local prompt=$2
  local use_resume=$3
  local status_text=$4
  local timestamp log_file prompt_file message_file

  timestamp="$(date +%Y%m%d-%H%M%S)-$$-$RANDOM"
  log_file="$runs_dir/$timestamp-$label.log"
  prompt_file="$runs_dir/$timestamp-$label.prompt.txt"
  message_file="$runs_dir/$timestamp-$label.last-message.txt"

  build_codex_command "$prompt" "$prompt_file" "$message_file" "$use_resume"

  local -a cmd=()
  while IFS= read -r -d '' item; do
    cmd+=("$item")
  done <"$prompt_file.cmd"

  LAST_LOG_FILE=$log_file
  LAST_PROMPT_FILE=$prompt_file
  LAST_MESSAGE_FILE=$message_file

  if [[ "$dry_run" -eq 1 ]]; then
    dashboard_note "[dry-run] $label"
    dashboard_note "[dry-run] cmd: $(quote_args "${cmd[@]}") < $prompt_file"
    dashboard_note "[dry-run] prompt preview follows"
    while IFS= read -r line; do
      dashboard_note "$line"
    done <<<"$prompt"
    return 0
  fi

  if ! run_and_log "$label" "$log_file" "$prompt_file" "$status_text" "${cmd[@]}"; then
    if log_has_limit_error "$log_file"; then
      dashboard_note "Codex stopped on a usage/rate limit during $label. Log: $log_file"
      LAST_INVOKE_LIMIT_ERROR=1
    else
      dashboard_note "Codex failed during $label. Log: $log_file"
      LAST_INVOKE_LIMIT_ERROR=0
    fi
    return 1
  fi

  LAST_INVOKE_LIMIT_ERROR=0
}

choose_next_spec_with_codex() {
  local use_resume=$1
  local selector_prompt

  selector_prompt=$(build_selector_prompt)
  invoke_codex "choose-spec" "$selector_prompt" "$use_resume" "choosing next spec" || return 1

  if [[ "$dry_run" -eq 1 ]]; then
    CHOSEN_SPEC=$(next_missing_spec "$todo_file")
    CHOSEN_REASON="dry-run fallback"
    return 0
  fi

  CHOSEN_SPEC=$(sed -n 's/^SPEC:[[:space:]]*//p' "$LAST_MESSAGE_FILE" | head -n 1)
  CHOSEN_REASON=$(sed -n 's/^REASON:[[:space:]]*//p' "$LAST_MESSAGE_FILE" | head -n 1)

  if [[ -z "$CHOSEN_SPEC" ]]; then
    die "could not parse selected spec from $LAST_MESSAGE_FILE"
  fi
  if [[ "$CHOSEN_SPEC" == "NONE" ]]; then
    return 2
  fi
}

build_judge_prompt() {
  local stage=$1
  local run_status=$2
  local suspicion_reasons=$3
  local before_head=$4
  local after_head=$5
  local before_todo_hash=$6
  local after_todo_hash=$7
  local before_status=$8
  local after_status=$9
  local recent_commits=${10}
  local name_status=${11}
  local todo_diff=${12}
  local final_message=${13}
  local log_tail=${14}

  cat <<EOF
Judge the result of a Codex supervisor stage in the Cora repo.

You are evaluating whether the outer loop should accept the run, retry the same stage once, stop, or escalate for human review.

Return exactly this format:
DECISION: accept|retry|stop|escalate
REASON: one sentence

Rules:
- Prefer \`accept\` if the run appears successful enough for the loop to continue.
- Use \`retry\` only for likely transient or recoverable issues where rerunning the same stage once is reasonable.
- Use \`stop\` when a human should inspect before continuing.
- Use \`escalate\` only for contradictory or unsafe repo state.
- Do not suggest more than one retry.

Stage: $stage
Codex exit status: $run_status
Suspicion reasons: $suspicion_reasons

Repo state:
- HEAD before: $before_head
- HEAD after: $after_head
- spec/TODO.md hash before: $before_todo_hash
- spec/TODO.md hash after: $after_todo_hash

Git status before:
$before_status

Git status after:
$after_status

Commits since stage start:
$recent_commits

Changed files in committed diff:
$name_status

TODO diff:
$todo_diff

Codex final message:
$final_message

Codex log tail:
$log_tail
EOF
}

invoke_judge() {
  local stage=$1
  local run_status=$2
  local suspicion_reasons=$3
  local before_head=$4
  local after_head=$5
  local before_todo_hash=$6
  local after_todo_hash=$7
  local before_status=$8
  local after_status=$9
  local recent_commits=${10}
  local name_status=${11}
  local todo_diff=${12}
  local final_message=${13}
  local log_tail=${14}

  local prompt
  prompt=$(build_judge_prompt \
    "$stage" "$run_status" "$suspicion_reasons" "$before_head" "$after_head" \
    "$before_todo_hash" "$after_todo_hash" "$before_status" "$after_status" \
    "$recent_commits" "$name_status" "$todo_diff" "$final_message" "$log_tail")

  invoke_codex "judge-$stage" "$prompt" 0 "judging $stage" || return 1

  if [[ "$dry_run" -eq 1 ]]; then
    JUDGE_DECISION="accept"
    JUDGE_REASON="dry-run"
    return 0
  fi

  JUDGE_DECISION=$(sed -n 's/^DECISION:[[:space:]]*//p' "$LAST_MESSAGE_FILE" | head -n 1 | tr '[:upper:]' '[:lower:]')
  JUDGE_REASON=$(sed -n 's/^REASON:[[:space:]]*//p' "$LAST_MESSAGE_FILE" | head -n 1)

  case "$JUDGE_DECISION" in
  accept | retry | stop | escalate) ;;
  *)
    JUDGE_DECISION="stop"
    JUDGE_REASON="Judge output was not parseable"
    ;;
  esac
}

run_stage_with_judge() {
  local stage=$1
  local prompt=$2
  local use_resume=$3
  local expect_todo_change=$4
  local attempt=${5:-0}
  local rollback_head=${6:-}
  local before_head before_todo_hash before_status after_head after_todo_hash after_status
  local run_status recent_commits name_status todo_diff final_message log_tail
  local suspicion_list=()
  local suspicion_reasons
  local stage_status_text

  before_head=$(current_head)
  if [[ -z "$rollback_head" ]]; then
    rollback_head=$before_head
  fi
  before_todo_hash=$(hash_file "$todo_file")
  before_status=$(capture_status)

  if [[ "$stage" == "porter" ]]; then
    stage_status_text="porting ${CURRENT_SPEC:-spec}"
  elif [[ "$stage" == "cleanup" ]]; then
    stage_status_text="running cleanup"
  else
    stage_status_text="running $stage"
  fi

  run_status=0
  if ! invoke_codex "$stage" "$prompt" "$use_resume" "$stage_status_text"; then
    run_status=1
    if [[ "${LAST_INVOKE_LIMIT_ERROR:-0}" -eq 1 ]]; then
      return 1
    fi
    suspicion_list+=("codex exited non-zero")
  fi

  if [[ "$dry_run" -eq 1 ]]; then
    return 0
  fi

  after_head=$(current_head)
  after_todo_hash=$(hash_file "$todo_file")
  after_status=$(capture_status)

  if [[ "$after_head" == "$before_head" ]]; then
    suspicion_list+=("no new commit was created")
  fi
  if [[ "$expect_todo_change" -eq 1 && "$after_todo_hash" == "$before_todo_hash" ]]; then
    suspicion_list+=("spec/TODO.md did not change")
  fi
  if [[ "$after_status" != "$before_status" ]]; then
    suspicion_list+=("git status changed across the run")
  fi

  if [[ "${#suspicion_list[@]}" -eq 0 ]]; then
    return 0
  fi

  recent_commits=$(capture_recent_commits "$before_head")
  name_status=$(capture_name_status "$before_head")
  todo_diff=$(capture_todo_diff "$before_head")
  final_message=$(cat "$LAST_MESSAGE_FILE" 2>/dev/null || true)
  log_tail=$(tail -n 80 "$LAST_LOG_FILE" 2>/dev/null || true)
  suspicion_reasons=$(join_by '; ' "${suspicion_list[@]}")

  dashboard_note "Suspicious $stage result; invoking judge. Reasons: $suspicion_reasons"
  invoke_judge \
    "$stage" "$run_status" "$suspicion_reasons" "$before_head" "$after_head" \
    "$before_todo_hash" "$after_todo_hash" "$before_status" "$after_status" \
    "$recent_commits" "$name_status" "$todo_diff" "$final_message" "$log_tail" ||
    die "judge failed for $stage"

  dashboard_note "Judge decision for $stage: $JUDGE_DECISION ($JUDGE_REASON)"

  case "$JUDGE_DECISION" in
  accept)
    if [[ "$run_status" -ne 0 ]]; then
      die "$stage failed and judge accept is unsafe"
    fi
    return 0
    ;;
  retry)
    if [[ "$attempt" -ge 1 ]]; then
      if [[ "$stage" == "porter" ]]; then
        rollback_to_stage_start "$rollback_head"
        STAGE_RESULT="rolled_back_failure"
        return 0
      fi
      die "$stage already retried once; judge requested another retry"
    fi
    dashboard_note "Retrying $stage once based on judge decision."
    run_stage_with_judge "$stage" "$prompt" "$use_resume" "$expect_todo_change" $((attempt + 1)) "$rollback_head"
    return
    ;;
  stop)
    if [[ "$stage" == "porter" && "$attempt" -ge 1 ]]; then
      rollback_to_stage_start "$rollback_head"
      STAGE_RESULT="rolled_back_failure"
      return 0
    fi
    die "$stage stopped by judge: $JUDGE_REASON"
    ;;
  escalate)
    if [[ "$stage" == "porter" && "$attempt" -ge 1 ]]; then
      rollback_to_stage_start "$rollback_head"
      STAGE_RESULT="rolled_back_failure"
      return 0
    fi
    die "$stage escalated by judge: $JUDGE_REASON"
    ;;
  esac
}

port_count_this_invocation=0
manual_target_consumed=0

while :; do
  porter_start_head=$(current_head)
  if [[ "$max_ports" -gt 0 && "$port_count_this_invocation" -ge "$max_ports" ]]; then
    dashboard_note "Reached max porter attempts: $max_ports"
    break
  fi

  if [[ -n "$target_spec" && "$manual_target_consumed" -eq 1 ]]; then
    break
  fi

  use_resume=0
  if [[ "$resume_last" -eq 1 && "$successful_runs" -gt 0 ]]; then
    use_resume=1
  fi

  if [[ -n "$target_spec" ]]; then
    CURRENT_SPEC=$target_spec
  else
    choose_next_spec_with_codex "$use_resume" || {
      selector_status=$?
      if [[ "$selector_status" -eq 2 ]]; then
        dashboard_note "No unchecked specs remain in $todo_file"
        break
      fi
      die "spec selection failed"
    }
    CURRENT_SPEC=$CHOSEN_SPEC
  fi

  dashboard_current_spec=$CURRENT_SPEC
  dashboard_note "Starting porter attempt for $CURRENT_SPEC"
  porter_prompt=$(build_porter_prompt "$CURRENT_SPEC")
  port_count_this_invocation=$((port_count_this_invocation + 1))
  STAGE_RESULT="success"
  run_stage_with_judge "porter" "$porter_prompt" "$use_resume" 1 || die "porter run failed for $CURRENT_SPEC"

  if [[ "$STAGE_RESULT" == "rolled_back_failure" ]]; then
    dashboard_note "Porter attempt failed after retry and was rolled back to clean state."
    if [[ -n "$target_spec" ]]; then
      break
    fi
    continue
  fi

  run_porter_verification_with_retry "$porter_start_head" "$porter_prompt" "$use_resume" || die "post-porter verification handling failed"

  if [[ "$STAGE_RESULT" == "rolled_back_failure" ]]; then
    dashboard_note "Porter attempt failed verification after retry and was rolled back to clean state."
    if [[ -n "$target_spec" ]]; then
      break
    fi
    continue
  fi

  successful_ports=$((successful_ports + 1))
  successful_runs=$((successful_runs + 1))
  manual_target_consumed=1
  persist_state

  commits_since_cleanup=$(count_commits_since "$cleanup_anchor_commit")
  if [[ "$cleanup_every_commits" -gt 0 && "$commits_since_cleanup" -ge "$cleanup_every_commits" ]]; then
    dashboard_note "Cleanup threshold reached at $commits_since_cleanup commits."
    cleanup_prompt=$(build_cleanup_prompt)
    run_stage_with_judge "cleanup" "$cleanup_prompt" "$use_resume" 0 || die "cleanup run failed"

    cleanup_runs=$((cleanup_runs + 1))
    successful_runs=$((successful_runs + 1))
    cleanup_anchor_commit=$(current_head)
    persist_state
  fi

  if [[ -n "$target_spec" ]]; then
    break
  fi
done

dashboard_cleanup
printf 'successful_ports=%s cleanup_runs=%s commits_since_cleanup=%s\n' \
  "$successful_ports" "$cleanup_runs" "$(count_commits_since "$cleanup_anchor_commit")"
